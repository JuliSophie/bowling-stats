# npm defaults give a single stalled download a 5-minute timeout and then retry it twice, so one
# flaky connection can freeze `npm install` for ~15 minutes. Worse, the progress bar only redraws
# when a timing event fires, so during that wait it sits on the last thing that finished (usually
# something like "reify:@emnapi/runtime") and looks like a hard hang. Fail fast and retry instead.
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=20000

# Both are extra network round trips after the install is already done, and neither is acted on
# here. Dropping them removes two more places the install can appear to stall at the very end.
audit=false
fund=false
