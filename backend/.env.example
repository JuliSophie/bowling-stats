# Backend environment variables (example)
# These variables use the `BOWLING_` prefix per app/config.py
# Set production values and keep this file outside of version control in real deployments.

# Environment: development | production
BOWLING_environment=production

# Database connection string (example using SQLite)
BOWLING_database_url=sqlite:///data/app.db

# Allowed CORS origins (comma-separated)
# Add your frontend origin and (optionally) the api subdomain if needed
BOWLING_cors_origins=http://localhost:3001,http://127.0.0.1:3001,https://bowling.sophiealexandra.de,https://bowling-api.sophiealexandra.de

# Shared-password gate. Set BOTH to enable auth; leave empty to disable.
# Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOWLING_app_password=change-me-to-a-strong-shared-password
BOWLING_auth_secret=change-me-to-a-random-signing-key
# Cookie domain so the auth cookie is shared across the frontend + api subdomains.
# Production: .sophiealexandra.de   |   localhost dev: leave empty.
BOWLING_auth_cookie_domain=.sophiealexandra.de
# Optional: session lifetime in days (default 30)
#BOWLING_auth_token_ttl_days=30

# Optional: path to tesseract binary if not on PATH
#BOWLING_tesseract_cmd=/usr/bin/tesseract

# Optional: override temp dir
#BOWLING_temp_dir=/var/lib/bowling/tmp

