# Backend environment variables (example)
# These variables use the `BOWLING_` prefix per app/config.py
# Set production values and keep this file outside of version control in real deployments.

# Environment: development | production
BOWLING_environment=production

# Database connection string (example using SQLite)
BOWLING_database_url=sqlite:///data/app.db

# Allowed CORS origins (comma-separated)
# Add your frontend origin and (optionally) the api subdomain if needed
BOWLING_cors_origins=http://localhost:3001,http://127.0.0.1:3001,https://bowling.sophiealexandra.de,https://api.bowling.sophiealexandra.de

# Optional: path to tesseract binary if not on PATH
#BOWLING_tesseract_cmd=/usr/bin/tesseract

# Optional: override temp dir
#BOWLING_temp_dir=/var/lib/bowling/tmp

